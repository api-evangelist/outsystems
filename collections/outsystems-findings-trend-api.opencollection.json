{
  "opencollection": "1.0.0",
  "info": {
    "name": "Code Quality Findings Trend API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Findings Trend",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves historical trend data for findings.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ODC_PORTAL_DOMAIN/api/code-quality/v1/findings-trend",
            "params": [
              {
                "name": "AssetKeys",
                "value": "",
                "type": "query",
                "description": "Filter by asset keys (unique identifiers)."
              },
              {
                "name": "AssetType",
                "value": "WebApplication",
                "type": "query",
                "description": "Filter by asset type."
              },
              {
                "name": "Categories",
                "value": "",
                "type": "query",
                "description": "Filter by finding categories."
              },
              {
                "name": "Severities",
                "value": "",
                "type": "query",
                "description": "Filter by finding severity levels."
              },
              {
                "name": "Since",
                "value": "2022-06-01T00:00:00",
                "type": "query",
                "description": "Start date for filtering findings by discovery time. Default: if omitted, 14 days before `To` (or 14 days before now, if `To` is also omitted)."
              },
              {
                "name": "To",
                "value": "2022-12-31T23:59:59",
                "type": "query",
                "description": "End date for filtering findings by discovery time. Default: if omitted, now (current UTC time)."
              },
              {
                "name": "ScoreRanges",
                "value": "\"0-49,50-84,85-100\"",
                "type": "query",
                "description": "Filter by quality score ranges. Default: includes all scores."
              },
              {
                "name": "Limit",
                "value": "50",
                "type": "query",
                "description": "Number of records to return per page."
              },
              {
                "name": "Offset",
                "value": "100",
                "type": "query",
                "description": "Number of records to skip for pagination."
              },
              {
                "name": "PortfolioKey",
                "value": "12345678-1234-1234-1234-123456789abc",
                "type": "query",
                "description": "Filter by portfolio key."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves historical trend data for findings over time, showing how findings and quality scores evolved across analyses. Useful for visualizing trends and patterns over time.\n\nExample: GET /code-quality/v1/findings-trend?assetKeys=abc123&since=2024-01-01&to=2024-12-31\n\nAPI Client needs the **Analyze > View Code Quality findings** permission."
        }
      ]
    }
  ],
  "bundled": true
}