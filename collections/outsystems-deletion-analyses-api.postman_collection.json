        {
          "id": "9f59d674-37c3-4af1-a5bd-f28f0f6bbf64",
          "name": "Launches a Deletion Analysis Process",
          "request": {
            "name": "Launches a Deletion Analysis Process",
            "description": {
              "content": "Launches a Deletion Analysis Process. This evaluates the impacts of deleting the associated asset.\nFor applications and agents, considers the impacts of undeploying them from their running stages, on their consumers\nFor libraries, considers what running applications are still consuming them, and evaluating the impact they'll have, on not being available to build, going forward\n\nAPI Client needs the **Asset management > Delete** permission.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "deletion-analyses"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetKey\": \"<string,null>\"\n}",
              "options": {
                "raw": {
