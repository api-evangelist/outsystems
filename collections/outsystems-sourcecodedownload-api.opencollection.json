{
  "opencollection": "1.0.0",
  "info": {
    "name": "External Library Generation Service Source Code Download API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "SourceCodeDownload",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Download Operation.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://ODC_PORTAL_DOMAIN/api/external-libraries/v1/assets/:assetKey/revisions/:revision/source-code-download",
            "params": [
              {
                "name": "assetKey",
                "value": "",
                "type": "path",
                "description": "Key of the desired external library."
              },
              {
                "name": "revision",
                "value": "",
                "type": "path",
                "description": "Id of the desired revision."
              }
            ]
          },
          "docs": "Asynchronously initiates the process to download the source code of a published external library.\n\nRequired permissions: **Asset management > Change**"
        },
        {
          "info": {
            "name": "Get Download Operation.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ODC_PORTAL_DOMAIN/api/external-libraries/v1/assets/:assetKey/revisions/:revision/source-code-download/:operationKey",
            "params": [
              {
                "name": "assetKey",
                "value": "",
                "type": "path",
                "description": "Key of the desired external library."
              },
              {
                "name": "revision",
                "value": "",
                "type": "path",
                "description": "Id of the desired revision."
              },
              {
                "name": "operationKey",
                "value": "",
                "type": "path",
                "description": "Key of the download operation."
              }
            ]
          },
          "docs": "Retrieves the current status of a download operation and the source code download URL if ready\n\nRequired permissions: **Asset management > Change**"
        }
      ]
    }
  ],
  "bundled": true
}